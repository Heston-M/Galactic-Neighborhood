  {
    "title": "Armor Class Explained",
    "topic": "rules",
    "route": "/rules/armor-class",
    "sections": [
      {
        "type": "heading",
        "text": "Armor Class (AC)",
        "headingLevel": 1
      },
      {
        "type": "text",
        "text": "Armor Class represents how difficult it is to land a successful attack against a creature. Higher AC means better protection."
      },
      {
        "type": "table",
        "tableInfo": {
          "title": "Armor Types",
          "headers": ["Armor", "AC", "Type"],
          "rows": [
            ["Leather", "11", "Light"],
            ["Chain Shirt", "13", "Light"],
            ["Scale Mail", "14", "Medium"],
            ["Chain Mail", "16", "Heavy"],
            ["Plate", "18", "Heavy"]
          ],
          "columnAlignments": ["flex-start", "center", "center"],
          "columnWidths": [100, 50, 100]
        }
      },
      {
        "type": "note",
        "noteInfo": {
          "noteTitle": "Remember",
          "noteContent": "AC can be modified by Dexterity, shields, magic items, and other factors."
        }
      }
    ]
