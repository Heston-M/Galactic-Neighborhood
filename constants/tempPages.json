[
  {
    "title": "Introduction to Combat for Dummies",
    "topic": "rules",
    "route": "/rules/combat-intro",
    "sections": [
      {
        "type": "text",
        "text": "This is a test of the collapsible component. It should be able to collapse and expand the content."
      },
      {
        "type": "heading",
        "text": "Combat Basics",
        "headingLevel": 1
      },
      {
        "type": "text",
        "text": "Combat in this game is turn-based and follows a structured sequence. Each round consists of several phases that determine the flow of battle."
      },
      {
        "type": "heading",
        "text": "Combat Sequence",
        "headingLevel": 2
      },
      {
        "type": "list",
        "listInfo": {
          "listType": "number",
          "listItems": [
            "Initiative Phase: All participants roll for initiative",
            "Action Phase: Characters take actions in initiative order",
            "Resolution Phase: Effects are resolved and damage is applied",
            "End Phase: Status effects are updated"
          ]
        }
      },
      {
        "type": "table",
        "tableInfo": {
          "title": "Initiative Modifiers",
          "headers": ["Condition", "Modifier"],
          "rows": [
            ["Surprised", "-5"],
            ["Prepared", "+2"],
            ["Hasted", "+3"]
          ],
          "columnAlignments": ["flex-start", "center"],
          "columnWidths": [100, 100]
        }
      },
      {
        "type": "heading",
        "text": "Action Phase",
        "headingLevel": 1
      },
      {
        "type": "text",
        "text": "The action phase is the main phase of combat. During this phase, characters take actions in initiative order."
      },
      {
        "type": "list",
        "listInfo": {
          "listType": "number",
          "listItems": [
            "Action Phase: Characters take actions in initiative order"
          ]
        }
      }
    ]
  },
  {
    "title": "Fireball Spell",
    "topic": "magic",
    "route": "/magic/fireball",
    "sections": [
      {
        "type": "heading",
        "text": "Fireball",
        "headingLevel": 1
      },
      {
        "type": "aspects",
        "aspectsInfo": [
          { "name": "School", "value": "Evocation" },
          { "name": "Level", "value": "3" },
          { "name": "Range", "value": "150 feet" }
        ]
      },
      {
        "type": "text",
        "text": "A bright streak flashes from your pointing finger to a point you choose within range and then blossoms into an explosion of flame. Each creature in a 20-foot-radius sphere centered on that point must make a Dexterity saving throw."
      },
      {
        "type": "table",
        "tableInfo": {
          "isDamageTable": true,
          "title": "Damage by Spell Level",
          "damageTableOutput": "Fire Damage",
          "rows": [
            ["3rd", "8d6"],
            ["4th", "9d6"],
            ["5th", "10d6"],
            ["6th", "11d6"]
          ],
          "columnWidths": [120, 50, 50, 50, 50]
        }
      },
      {
        "type": "note",
        "noteInfo": {
          "noteTitle": "Important",
          "noteContent": "The fire ignites flammable objects in the area that aren't being worn or carried."
        }
      }
    ]
  },
  {
    "title": "Longsword",
    "topic": "equipment",
    "route": "/equipment/longsword",
    "sections": [
      {
        "type": "heading",
        "text": "Longsword",
        "headingLevel": 1
      },
      {
        "type": "aspects",
        "aspectsInfo": [
          { "name": "Type", "value": "Melee Weapon" },
          { "name": "Cost", "value": "15 gp" },
          { "name": "Weight", "value": "3 lbs" }
        ]
      },
      {
        "type": "text",
        "text": "A versatile weapon favored by warriors and knights. The longsword can be wielded with one or two hands, making it adaptable to various combat situations."
      },
      {
        "type": "table",
        "tableInfo": {
          "title": "Weapon Properties",
          "headers": ["Property", "Description"],
          "rows": [
            ["Versatile", "Can be used one-handed (1d8) or two-handed (1d10)"],
            ["Finesse", "Can use Dexterity instead of Strength"],
            ["Martial", "Requires proficiency to use effectively"]
          ],
          "columnAlignments": ["flex-start", "flex-start"],
          "columnWidths": [100, 300]
        }
      }
    ]
  },
  {
    "title": "Character Creation Guide",
    "topic": "characters",
    "route": "/characters/creation",
    "sections": [
      {
        "type": "heading",
        "text": "Creating Your Character",
        "headingLevel": 1
      },
      {
        "type": "text",
        "text": "Character creation is the first step in your adventure. Follow these steps to bring your hero to life."
      },
      {
        "type": "heading",
        "text": "Step 1: Choose a Race",
        "headingLevel": 2
      },
      {
        "type": "list",
        "listInfo": {
          "listType": "bullet",
          "listItems": [
            "Human: Versatile and adaptable",
            "Elf: Graceful and long-lived",
            "Dwarf: Hardy and skilled craftsmen",
            "Halfling: Brave and lucky"
          ]
        }
      },
      {
        "type": "heading",
        "text": "Step 2: Choose a Class",
        "headingLevel": 2
      },
      {
        "type": "list",
        "listInfo": {
          "listType": "bullet",
          "listItems": [
            "Fighter: Master of combat",
            "Wizard: Master of arcane magic",
            "Rogue: Master of stealth and skill",
            "Cleric: Master of divine magic"
          ]
        }
      },
      {
        "type": "note",
        "noteInfo": {
          "noteTitle": "Tip",
          "noteContent": "Consider your character's background and personality when making these choices. A well-rounded character is more fun to play!"
        }
      }
    ]
  },
  {
    "title": "Game Overview",
    "topic": "general",
    "route": "/general/overview",
    "sections": [
      {
        "type": "heading",
        "text": "Welcome to the Game",
        "headingLevel": 1
      },
      {
        "type": "text",
        "text": "This is a tabletop role-playing game where you take on the role of heroic adventurers exploring a fantasy world filled with magic, monsters, and mystery."
      },
      {
        "type": "text",
        "text": "In this game, you will take on the role of heroic adventurers exploring a fantasy world filled with magic, monsters, and mystery."
      },
      {
        "type": "heading",
        "text": "Core Concepts",
        "headingLevel": 2
      },
      {
        "type": "list",
        "listInfo": {
          "listType": "number",
          "listItems": [
            "The Game Master (GM) describes the world and situations",
            "Players describe what their characters do",
            "Dice rolls determine success or failure",
            "Collaborative storytelling creates the adventure"
          ]
        }
      },
      {
